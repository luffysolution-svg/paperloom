{
  "name": "retain-pdf-desktop",
  "productName": "PaperLoom",
  "version": "0.1.5",
  "private": true,
  "description": "PaperLoom desktop wrapper",
  "homepage": "https://github.com/luffysolution-svg/paperloom",
  "author": {
    "name": "luffysolution-svg",
    "email": "luffysolution@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/run-local.mjs",
    "lint": "eslint --max-warnings=0 main.js preload.js src/main scripts/pack-current-asar.mjs scripts/remote-windows.mjs scripts/run-local.mjs",
    "test": "npm run lint && node --test scripts/runtime-prune.test.mjs src/main/*.test.mjs",
    "sync:win-frontend": "node scripts/sync-win-frontend.mjs",
    "install-git-hooks": "sh scripts/install-git-hooks.sh",
    "smoke:frontend-bundle": "node scripts/check-frontend-bundle.mjs",
    "smoke:frontend-desktop": "npm --prefix ../web run smoke:desktop-first-run && npm run smoke:frontend-bundle",
    "report:size": "node scripts/report-package-size.mjs",
    "verify:packaging-deps": "node scripts/check-packaging-dependencies.mjs",
    "sync-frontend": "npm --prefix ../web run build && node scripts/prepare-app.mjs --frontend-only",
    "verify-frontend-sync": "npm run sync-frontend && npm run smoke:frontend-desktop",
    "prepare-app": "npm --prefix ../.. run build:doc && npm --prefix ../web run build && node scripts/prepare-app.mjs",
    "dist:win32": "npm run prepare-app && npm run verify:packaging-deps && electron-builder --win portable --x64 --config.directories.output=win",
    "dist:win32-installer": "npm run prepare-app && npm run verify:packaging-deps && electron-builder --win nsis portable --x64 --config.directories.output=win",
    "dist:mac": "RETAIN_PDF_BUNDLE_MAC_PYTHON=1 npm run prepare-app && npm run verify:packaging-deps && RETAIN_PDF_BUNDLE_MAC_PYTHON=1 electron-builder --mac dmg --publish never --config.directories.output=mac",
    "dist:linux": "npm run prepare-app && npm run verify:packaging-deps && electron-builder --linux deb --publish never --config.directories.output=linux"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "10.8.1"
  },
  "build": {
    "appId": "com.luffysolution.paperloom",
    "protocols": [
      {
        "name": "PaperLoom",
        "schemes": [
          "paperloom"
        ]
      }
    ],
    "productName": "PaperLoom",
    "electronVersion": "44.4.3",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "app/frontend/**/*",
      "assets/**/*",
      "!assets/fonts/**/*",
      "main.js",
      "preload.js",
      "src/main/**/*",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/backend",
        "to": "backend"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW"
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PaperLoom-Windows-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "electronLanguages": [
        "en",
        "zh_CN",
        "zh_TW"
      ],
      "artifactName": "PaperLoom-Mac-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW"
      ],
      "maintainer": "luffysolution-svg <luffysolution@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "PaperLoom",
          "Comment": "PDF retain-layout translation desktop application",
          "Categories": "Office;Utility;",
          "StartupWMClass": "PaperLoom"
        }
      },
      "artifactName": "PaperLoom-Linux-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PaperLoom-Windows-${version}-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "license": "AGPL-3.0-only"
}
