{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/agent-run-manifest/v1",
  "title": "PaperLoom Agent run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "command", "inputs", "options", "items", "outputs"],
  "properties": {
    "schema_version": { "const": "agent-run-manifest.v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "command": { "type": "string" },
    "paperloom_version": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "options": { "type": "object", "additionalProperties": true },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "outputs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "status"],
      "properties": {
        "item_id": { "type": "string" },
        "source": { "type": "string" },
        "document_id": { "type": "string" },
        "job_id": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "queued", "running", "succeeded", "failed", "canceled", "skipped"] },
        "error": { "type": "string" },
        "outputs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
